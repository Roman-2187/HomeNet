<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="using:HomeNetAvalonia.Behaviors"
             xmlns:chat="clr-namespace:HomeNetPresentation.ViewModels.ClientViews.Chat;assembly=HomeNetPresentation"

            mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="500"
             x:Class="HomeNetAvalonia.Controls.UserControls.ChatViewControl"
             x:DataType="chat:ChatViewModel" >

      <UserControl.Styles>
        <!-- 🕶️ ЧУЖИЕ СООБЩЕНИЯ (Входящие слева): -->
        <Style Selector="Border.msg-cloud">
            <Setter Property="Border.HorizontalAlignment" Value="Center"/>
            <Setter Property="Border.Background" Value="#1500F0FF"/>
            <Setter Property="Border.Margin" Value="10,10,250,10"/>
        </Style>

        <!-- 🎯 ТВОИ СООБЩЕНИЯ (Исходящие справа): -->
        <Style Selector="Border.msg-cloud[Tag=true]">
            <Setter Property="Border.HorizontalAlignment" Value="Center"/>
            <Setter Property="Border.Background" Value="#3300F0FF"/>
            <Setter Property="Border.Margin" Value="250,10,10,10"/>
        </Style>

           <!-- 🔥 УБИРАЕМ РАМКУ И ФОН У TEXTBOX ВООБЩЕ (включая фокус) -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,0"/>
    </Style>

    <!-- Убираем подсветку при наведении -->
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#1500F0FF"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Убираем подсветку при фокусе -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#10ADD8E6"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

           <Style Selector="Button.cyber-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/> <!-- Убираем стандартные отступы -->
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

     <!-- 🔥 КРАСИВАЯ КНОПКА ОТПРАВКИ -->
    <Style Selector="Button.action-btn">
        <!-- Убираем стандартный фон и рамку -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5,5"/> <!-- Нормальные отступы для текста -->
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Height" Value="45"/> 

        
        <!-- Центрируем текст по вертикали и горизонтали -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Наведение: аккуратная подсветка -->
    <Style Selector="Button.action-btn:pointerover">
        <Setter Property="Background" Value="#3300F0FF"/> <!-- Полупрозрачный голубой -->
    </Style>

    <!-- Нажатие: чуть ярче -->
    <Style Selector="Button.action-btn:pressed">
        <Setter Property="Background" Value="#5500F0FF"/>
    </Style>

          <Style Selector="Button.action-btn:disabled">
    <Setter Property="Foreground" Value="#FF615959"/> <!-- Серый текст -->
    <Setter Property="Background" Value="Transparent"/>
</Style>
        
        
        <Style Selector="TextBlock.msg-text">
            <Setter Property="Foreground" Value="#00F0FF"/>
        </Style>
        
        <Style Selector="TextBlock.deleted-msg">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="#7A8B99"/>
        </Style>
    </UserControl.Styles>



 <ContentControl Classes="CyberpunkInnerContainer" 
    DataContext="{DynamicResource ComponentHub}" 
    x:CompileBindings="False">
    
    <!-- 🔥 ЕДИНЫЙ КИБЕР-КОНТЕЙНЕР (вместо отдельных кусков) -->
    <Border Name="ChatRoot"
            Focusable="True" 
            Background="Transparent"
            behaviors:ClearFocusBehavior.IsEnabled="True"
            DataContext="{Binding ChatViewModel}">

        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- 🔝 ВЕРХНЯЯ ЧАСТЬ: Шапка текущего чата -->
            <!-- Отделяем нижней линией, без фона -->
            <Border
                Grid.Row="0"
                
                BorderBrush="#3300F0FF"
                BorderThickness="0"
                Background="#1100F0FF"
                Height="45"
                Padding="15,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="10" Height="10" Fill="#00FF66" VerticalAlignment="Center"/>
                    <TextBlock 
                        Text="{Binding State.SelectedFriendName, FallbackValue='Загрузка ...'}"
                        Foreground="#00F0FF"
                        FontWeight="Bold"
                        FontSize="14"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 💬 СРЕДНЯЯ ЧАСТЬ: Лента сообщений (прозрачный фон, чтобы просвечивал главный) -->
            <ScrollViewer HorizontalAlignment="Stretch"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled" 
                VerticalScrollBarVisibility="Auto"
                behaviors:AutoScrollBehavior.EnableAutoScroll="True"
                Padding="10">
                
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="chat:MessageItemViewModel">
            
                            <!-- Сам пузырь (без рамки, но с легкой тенью для объема) -->
                            <Border Classes="msg-cloud" 
                                    Tag="{Binding IsOutgoing}"
                                    Padding="10" 
                                    CornerRadius="6" 
                                    BorderThickness="0"
                                    MinWidth="200"
                                    MaxWidth="200"
                                    BoxShadow="0 0 10 0 #2200F0FF">
                
                                <!-- Контекстное меню для мягкого удаления своих сообщений -->
                                <Border.ContextMenu>
                                    <ContextMenu IsVisible="{Binding IsOutgoing}">
                                        <MenuItem Header="Удалить сообщение"
                                                  IsVisible="{Binding !IsDeleted}"
                                                  Command="{Binding #ChatRoot.DataContext.DeleteMessageCommand}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid RowDefinitions="Auto, Auto">
                                    <TextBlock  Classes="msg-text"
                                                Grid.Row="0" 
                                                Text="{Binding Text}"
                                                Classes.deleted-msg="{Binding IsDeleted}"
                                                FontSize="13"
                                                TextWrapping="Wrap"/>
                                    <TextBlock
                                        Grid.Row="1" 
                                        Text="{Binding FormattedTime, FallbackValue='00:00'}"
                                        Foreground="#5500F0FF" 
                                        FontSize="10" 
                                        HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>

            <!-- ⌨️ НИЖНЯЯ ЧАСТЬ: Поле ввода и кнопка (тоже без фона, но с линией сверху) -->
            <Border
                Grid.Row="2"
                Background="Transparent"
                
               
                >
                <Grid ColumnDefinitions="*, Auto"  Height="45">
                   
                    
                    
                    <TextBox Name="MessageBox"
                             Grid.Column="0" 
                             Text="{Binding State.InputText, Mode=TwoWay}" 
                             PlaceholderText="Введите сообщение..." 
                             Foreground="#00F0FF" 
                             Background="Transparent" 
                             FontSize="13" 
                             VerticalContentAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" 
                                        Command="{Binding SendMessageCommand}" 
                                        CommandParameter="{Binding #MessageBox.Text}"/>
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="ОТПРАВИТЬ"
                            Command="{Binding SendMessageCommand}"
                            IsEnabled="{Binding #MessageBox.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Classes="action-btn"
                            FontSize="14"
                            Width="120"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ContentControl>
</UserControl>

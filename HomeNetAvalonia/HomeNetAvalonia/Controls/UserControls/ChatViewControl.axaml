<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="using:HomeNetAvalonia.Behaviors"
             xmlns:chat="clr-namespace:HomeNetPresentation.ViewModels.ClientViews.Chat;assembly=HomeNetPresentation"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="500"
             x:Class="HomeNetAvalonia.Controls.UserControls.ChatViewControl"
             x:DataType="chat:ChatViewModel" >

   




      <ContentControl Classes="CyberpunkInnerContainer" Padding="0"
                    DataContext="{DynamicResource ComponentHub}" 
                    x:CompileBindings="False">
        
        <Border Name="ChatRoot"
                Focusable="True" 
                Background="Transparent"
                behaviors:ClearFocusBehavior.IsEnabled="True"
                DataContext="{Binding ChatViewModel}">

            <Grid RowDefinitions="Auto, *, Auto">
                
                <!-- 🔝 ВЕРХНЯЯ ЧАСТЬ: Шапка текущего чата -->
                <Border Grid.Row="0"
                        CornerRadius="2"
                        BorderBrush="#3300F0FF"
                        BorderThickness="0"
                        Background="#1100F0FF"
                        Height="45"
                        Padding="15,10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse Width="10" Height="10"
                                 Fill="#00FF66" VerticalAlignment="Center"/>
                        <TextBlock 
                            Text="{Binding State.SelectedFriendName, 
                            FallbackValue='Загрузка ...'}"
                            Foreground="#00F0FF"
                            FontWeight="Bold"
                            FontSize="14"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 💬 СРЕДНЯЯ ЧАСТЬ: Лента сообщений -->
                
                    
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Messages}"
                         SelectedItem="{Binding SelectedMessage}"
                         behaviors:SmartScrollBehavior.Enable="True"
                         behaviors:SmartScrollBehavior.ScrollDownButton="{Binding #ScrollDownBtn}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0">

                        <!-- Убираем стандартную подсветку и отступы ListBoxItem -->
                        <ListBox.Styles>
                            
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>

                        <!-- 🔥 КОНТЕКСТНОЕ МЕНЮ НАВЕРХУ (в контексте ChatViewModel) -->
                        <ListBox.ContextMenu>
                            <ContextMenu
                                IsVisible="{Binding SelectedMessage.IsOutgoing,
                                 FallbackValue=False}">
                                <MenuItem
                                    Header="Удалить сообщение"
                                    IsVisible="{Binding !SelectedMessage.IsDeleted,
                                     FallbackValue=False}"
                                    Command="{Binding DeleteMessageCommand}"
                                    CommandParameter="{Binding SelectedMessage}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Сетка: левая колонка | правая колонка -->
                                <Grid ColumnDefinitions="*, *">
                                    
                                    <Border Classes="msg-cloud" 
                                            Tag="{Binding IsOutgoing}"
                                            Padding="20,10" 
                                            BorderThickness="1"
                                            MinWidth="200"
                                            BoxShadow="0 0 10 0 #2200F0FF">

                                        <Grid RowDefinitions="Auto, Auto">
                                            <TextBlock
                                                Classes="msg-text"
                                                Grid.Row="0" 
                                                Text="{Binding Text}"
                                                Classes.deleted-msg="{Binding IsDeleted}"
                                                FontSize="13"
                                                TextWrapping="Wrap"/>
                                            <TextBlock
                                                Grid.Row="1" 
                                                Text="{Binding FormattedTime, FallbackValue='00:00'}"
                                                Foreground="#5500F0FF" 
                                                FontSize="10" 
                                                HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                
                <!-- 🔥 ПЛАВАЮЩАЯ ТРЕУГОЛЬНАЯ КИБЕР-КНОПКА "ВНИЗ" -->
                <Button Grid.Row="1" Name="ScrollDownBtn" Classes="cyber-triangle-btn"
                        Width="38" Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,22,15"
                        IsVisible="False"
                        Cursor="Hand">
                    <Grid>
                        <!-- Сам треугольник (остриём вниз) -->
                        <Polygon Points="0,0 38,0 19,34"
                                 Fill="#DD1B222E"
                                 Stroke="#00F0FF"
                                 StrokeThickness="1.2"/>
                        <!-- Внутренняя неоновая стрелка-шеврон -->
                        <Path Data="M 13,10 L 19,17 L 25,10"
                              Stroke="#00F0FF"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"/>
                    </Grid>
                </Button>


               
                <!-- ⌨️ НИЖНЯЯ ЧАСТЬ: Поле ввода и кнопка -->
                <Border Grid.Row="2"
                        Background="Transparent">
                    <Grid ColumnDefinitions="*, Auto" Height="45">
                        
                        <TextBox Name="MessageBox" Classes="cyber-input"
                                 Grid.Column="0" 
                                 Text="{Binding State.InputText, Mode=TwoWay}" 
                                 PlaceholderText="Введите сообщение..." 
                                 VerticalContentAlignment="Center">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" 
                                            Command="{Binding SendMessageCommand}" 
                                            CommandParameter="{Binding #MessageBox.Text}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <Button Grid.Column="1"  Classes="cyber-send-btn"
                                Content="ОТПРАВИТЬ"
                                Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding #MessageBox.Text,
                                 Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" Width="120"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ContentControl>


</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:controls="using:HomeNetAvalonia.Controls"
             xmlns:clientViews="clr-namespace:HomeNetPresentation.ViewModels.ClientViews;assembly=HomeNetPresentation"
             xmlns:mainControls="clr-namespace:HomeNetAvalonia.Controls.MainControls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500"
             x:Class="HomeNetAvalonia.Controls.UserControls.ContactsListViewControl"
             x:DataType="clientViews:ContactsViewModel">

    <!-- 🌌 Глобальный DataContext Хаба для полной автономности контрола -->


   
  <ContentControl Classes="CyberpunkInnerContainer" Margin="-6"
    
     >
    
    <!-- 🦾 Автоматически проваливаемся в родную ContactsViewModel -->
    <!-- 🔥 Задаем RowDefinitions="*", чтобы этот Grid растянулся на всё пространство -->
    <Grid Background="#10ADD8E6"
       
        RowDefinitions="*">
        
      
        
        <!-- 🛡️ ЕДИНЫЙ КИБЕР-КОНТЕЙНЕР ДЛЯ ПАНЕЛИ КОНТАКТОВ -->
       
            
            <!-- 🔥 Внутренний Grid с двумя строками -->
            <Grid RowDefinitions="Auto, *">  
                
                
                <!-- 🍔 ВЕРХНЯЯ ЧАСТЬ: Кнопка управления, выхода и имя текущего юзера -->
                <Border 
                    Grid.Row="0"
                    Background="#1100F0FF"
                    BorderBrush="#3300F0FF"
                    
                    CornerRadius="2"
                    Padding="5" >
                    <Grid ColumnDefinitions="Auto, *">

                         <Button Content="☰"
                        Height="35" Width="35"
                       
                        FontSize="16"
                        Command="{Binding  ToggleMenuCommand}" />


                     
             <StackPanel
    Height="35"
    Grid.Column="1"
    Orientation="Horizontal"
    HorizontalAlignment="Right"
    Spacing="8" 
    Margin="0,0,5,0">

    <!-- Контейнер для аватарки + индикатор онлайна -->
    <Grid Width="35" Height="35" VerticalAlignment="Center">
        <Border
            CornerRadius="3"
            ClipToBounds="True">
            <Image
                Source="{StaticResource BlackCatAvatar}"
                Stretch="UniformToFill"/>
        </Border>
        
        <Ellipse 
            Width="8"
            Height="8" 
            Fill="#00FF66"
            Stroke="#1A1A1A"
            StrokeThickness="1.5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"/>
    </Grid>

   
</StackPanel>


                    </Grid>
                </Border>

                <!-- 👥 НИЖНЯЯ ЧАСТЬ: Список контактов -->
                <!-- 🔥 Строка "*" заставит ListBox занять всё оставшееся место -->
              <ListBox 
                Grid.Row="1"
                ItemsSource="{Binding Friends}" 
                SelectedItem="{Binding SelectedFriend, Mode=TwoWay}"
                Background="Transparent"
                BorderThickness="0"
                Margin="0,2,0,0">
              <ListBox.ItemContainerTheme>
    
    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        
       
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="5"/>

       
      
       <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1100F0FF" />
            <Setter Property="BorderBrush" Value="#00F0FF" />   <!-- Яркий голубой для полоски -->
            <Setter Property="BorderThickness" Value="0.6,0,0,0" />
            <Setter Property="CornerRadius" Value="2" /> <!-- Полоска только слева -->
        </Style>

       
       
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="#1500F0FF" />
                <Setter Property="CornerRadius" Value="2" /> 
<!-- Очень прозрачный голубой -->
        </Style>
        
       

    </ControlTheme>
</ListBox.ItemContainerTheme>

   <ListBox.ItemTemplate>
    <DataTemplate>
        <TextBlock 
            Text="{Binding FirstName}" 
            Foreground="#00F0FF" 
            FontSize="15" 
            Padding="15,8" />
    </DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
    
   
                
            </Grid>
        <mainControls:SideMenuControl
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>
    </Grid>

       
</ContentControl>
</UserControl>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
        <!-- 🕶️ ЧУЖИЕ СООБЩЕНИЯ (срез верхний левый угол 14x14 px) -->
        <Style Selector="Border.msg-cloud">
                <Setter Property="Grid.Column" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Background" Value="#1500F0FF"/>
                <Setter Property="Margin" Value="100,0,-30,0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0,0" EndPoint="14,14" SpreadMethod="Pad">
                                <GradientStop Color="Transparent" Offset="0.49"/>
                                <GradientStop Color="Black" Offset="0.51"/>
                        </LinearGradientBrush>
                </Setter>
        </Style>

        <!-- 🎯 ТВОИ СООБЩЕНИЯ (зеркалим сам Border — срез уходит в верхний правый угол) -->
        <Style Selector="Border.msg-cloud[Tag=true]">
                <Setter Property="Grid.Column" Value="2"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="#3300F0FF"/>
                <Setter Property="Margin" Value="-30,0,100,0"/>
                <Setter Property="RenderTransform">
                        <ScaleTransform ScaleX="-1" ScaleY="1"/>
                </Setter>
        </Style>

        <!-- Переворачиваем внутренний Grid обратно, чтобы текст не был зеркальным -->
        <Style Selector="Border.msg-cloud[Tag=true] > Grid">
                <Setter Property="RenderTransform">
                        <ScaleTransform ScaleX="-1" ScaleY="1"/>
                </Setter>
        </Style>

        <!-- Текст обычного сообщения -->
        <Style Selector="TextBlock.msg-text">
                <Setter Property="Foreground" Value="#00F0FF"/>
        </Style>

        <!-- Текст удалённого сообщения -->
        <Style Selector="TextBlock.deleted-msg">
                <Setter Property="FontStyle" Value="Italic"/>
                <Setter Property="Foreground" Value="#7A8B99"/>
        </Style>
</Styles>
